# Server
POSTGRES_PORT=5433
DATABASE_URL=postgres://chen:chen@127.0.0.1:5433/chen_leveling
BIND_ADDR=0.0.0.0:18080
ALLOWED_ORIGIN=*
AUTO_MIGRATE=true
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_TTL_SECONDS=28800

