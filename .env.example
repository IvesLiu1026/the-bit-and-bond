# Server
POSTGRES_PORT=5433
DATABASE_URL=postgres://chen:chen@127.0.0.1:5433/the_bit_and_bond
BIND_ADDR=0.0.0.0:18080
APP_ENV=development
ALLOWED_ORIGIN=*
ALLOW_ANY_ORIGIN=false
AUTO_MIGRATE=true
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_TTL_SECONDS=28800
FIREBASE_PROJECT_ID=the-bit-and-bond

# Voice (LiveKit self-hosted)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_TOKEN_TTL_SECONDS=7200
LIVEKIT_CHAT_TOPIC=guild.chat

# Optional: Redis pub/sub for realtime presence
# REDIS_URL=redis://127.0.0.1:6379

# Flutter (use with --dart-define)
# --dart-define=API_BASE_URL=http://127.0.0.1:18080
# For LAN/iPad testing, replace 127.0.0.1 with your PC's LAN IP.
# --dart-define=LIVEKIT_URL=ws://127.0.0.1:7880
# --dart-define=HOUSEHOLD_ID=00000000-0000-0000-0000-000000000001
# --dart-define=CHILD_MEMBER_ID=00000000-0000-0000-0000-000000000011
# --dart-define=GUARDIAN_MEMBER_ID=00000000-0000-0000-0000-000000000021
